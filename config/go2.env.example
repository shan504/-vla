# Copy to config/go2.env (ignored); shell syntax, no credentials.
MODEL_PATH=checkpoints/InternVLA-N1-DualVLN
MODEL_DEVICE=cuda:0
ATTENTION=sdpa
PLAN_STEP_GAP=4
# For a robot on the same LAN set SERVER_HOST=0.0.0.0.
SERVER_HOST=127.0.0.1
SERVER_PORT=5801
# Replace with the GPU workstation's LAN address, reachable from the robot.
SERVER_URL=http://192.168.123.100:5801/eval_dual
ROBOT_IF=eth0
ROS_DISTRO=foxy
INSTRUCTION='Walk to the doorway and stop.'
