# Copy to config/slurm.env; use actual values returned by this cluster's sinfo.
# Confirmed site partition: gpu_4090. Request one GPU; the job verifies RTX 4090.
INTERNNAV_PARTITION=gpu_4090
INTERNNAV_GRES=gpu:1
# Optional: only when required by your allocation.
INTERNNAV_ACCOUNT=
INTERNNAV_QOS=
# Normal server default: 2 hours. --probe always requests 10 minutes.
INTERNNAV_TIME=02:00:00
